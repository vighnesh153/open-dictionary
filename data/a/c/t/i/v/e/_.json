{
  "word": "active",
  "meanings": [
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Having the power or quality of acting; causing change; communicating action or motion; acting;—opposed to passive, that receives.",
      "examples": [
        "certain active principles",
        "the active powers of the mind"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Quick in physical movement; of an agile and vigorous body; nimble.",
      "examples": [
        "an active child or animal"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "In action; actually proceeding; working; in force",
      "examples": [
        "active laws",
        "active hostilities"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Given to action; constantly engaged in action; energetic; diligent; busy",
      "examples": [
        "an active man of business",
        "active mind",
        "active zeal"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Requiring or implying action or exertion",
      "examples": [
        "active employment or service",
        "active scenes"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Given to action rather than contemplation; practical; operative",
      "examples": [
        "an active rather than a speculative statesman"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Brisk; lively.",
      "examples": [
        "an active demand for corn"
      ]
    },
    {
      "language": "ENGLISH",
      "type": "ADJECTIVE",
      "meaning": "Implying or producing rapid action.",
      "examples": [
        "an active disease",
        "an active remedy"
      ]
    }
  ]
}